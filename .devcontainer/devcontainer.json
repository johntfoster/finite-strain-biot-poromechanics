{
  "name": "Nonlinear Biot: MOOSE and manuscript",
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb",
    "storage": "64gb"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "waitFor": "postCreateCommand",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Companion website",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "James-Yu.latex-workshop"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/.agent-runtime/**": true
        },
        "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/paper/build",
        "latex-workshop.latex.tools": [
          {
            "name": "paper",
            "command": "make",
            "args": [
              "-C",
              "%WORKSPACE_FOLDER%",
              "paper"
            ]
          }
        ],
        "latex-workshop.latex.recipes": [
          {
            "name": "Canonical manuscript",
            "tools": [
              "paper"
            ]
          }
        ]
      }
    }
  },
  "image": "ghcr.io/johntfoster/finite-strain-biot-poromechanics@sha256:8a68ecc914ed365844c9180d35e0a32c238bc4d4144943101015ff97259a38a2",
  "features": {
    "ghcr.io/devcontainers/features/sshd@sha256:f5251b8e4325f68f7280973c6cd65daff414449c66f240621502d4e8e74eb7ee": {}
  }
}
