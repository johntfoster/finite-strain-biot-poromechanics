{
  "name": "Nonlinear Biot: MOOSE and manuscript",
  "build": {"dockerfile": "Dockerfile"},
  "remoteUser": "vscode",
  "hostRequirements": {"cpus": 8, "memory": "32gb", "storage": "64gb"},
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "waitFor": "postCreateCommand",
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "Companion website", "onAutoForward": "notify"}},
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-python.python", "James-Yu.latex-workshop"],
      "settings": {
        "files.watcherExclude": {"**/.agent-runtime/**": true},
        "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/paper/build",
        "latex-workshop.latex.tools": [{"name": "paper", "command": "make", "args": ["-C", "%WORKSPACE_FOLDER%", "paper"]}],
        "latex-workshop.latex.recipes": [{"name": "Canonical manuscript", "tools": ["paper"]}]
      }
    }
  }
}
