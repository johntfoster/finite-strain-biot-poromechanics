[Tests]
  design = 'paper/sections/implicit_ad_implementation.tex'
  issues = ''
  [poroplastic_initial_mass]
    type = RunCommand
    command = 'python3 ../../../../validation/scripts/check_conservative_plastic_initial_state.py'
    max_time = 180
    requirement = 'Fluid mass shall initialize from the prescribed nonzero deformation, pressure and plastic history and remain constant in a sealed stationary body.'
  []
  [poroplastic_mandel_storage]
    type = RunCommand
    command = 'python3 ../../../../validation/scripts/check_poroplastic_mandel.py --quick'
    max_time = 600
    requirement = 'Active plastic flow in a Q2/Q1 coupled drainage problem shall retain the plastic pore-volume rate, pass independent mineral and water-accumulation derivatives, and preserve the assembled AD Jacobian.'
  []
  [poroplastic_mandel_refinement]
    type = RunCommand
    command = 'python3 ../../../../validation/scripts/check_poroplastic_mandel.py'
    heavy = true
    max_time = 14400
    requirement = 'Coupled poroplastic compression and drainage shall recover the elastic limit and preserve solid mass and discrete fluid mass on every refinement while reporting spatial and temporal sensitivity.'
  []
  [poroplastic_spatial_stability]
    type = RunCommand
    command = 'python3 ../../../../validation/scripts/check_poroplastic_spatial_stability.py --run --reuse'
    heavy = true
    max_time = 14400
    requirement = 'The zero-hardening control shall expose the diagnosed acoustic sign change, while isotropic hardening shall retain positive sampled acoustic determinants and resolved spatial fields under mesh and time-step refinement.'
  []
[]
