#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

# Infrastructure-only maintenance: never run manuscript-mutating hooks while frozen.
if [ "$(git config --bool --get research.manuscriptFreeze || printf true)" = "true" ]; then
    python3 .agent/shared/tools/research_project.py freeze
    exit 0
fi

pending_date=$(date +%Y-%m-%d)
python3 tools/update_ai_disclosure.py --pending-date "$pending_date"
git add -- provenance/AI_USE.md provenance/ai_use_statement.tex
python3 tools/update_ai_disclosure.py --check --pending-date "$pending_date"
if [ -f validation/provenance.yml ]; then
    python3 scripts/update_validation_provenance.py --check-staged
    git add -- validation/provenance.yml
fi
