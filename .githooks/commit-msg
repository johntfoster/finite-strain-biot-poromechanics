#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

# Merge messages are generated by Git and describe integration rather than a
# single development window. All ordinary commits require the process log.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

python3 tools/validate_process_log.py "$1"
